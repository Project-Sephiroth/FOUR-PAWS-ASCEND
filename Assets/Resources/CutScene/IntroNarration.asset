%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f63088f7aac064d43b16d6e403011d8a, type: 3}
  m_Name: IntroNarration
  m_EditorClassIdentifier: Assembly-CSharp::IntroNarration
  cuts:
  - id: 0
    lines:
    - "\uC5EC\uAE30\uB294 \uD3C9\uD654\uB85C\uC6B4 \uB3D9\uC0B0.\r\n\r\n\uC624\uB298\uB3C4
      \uC5B8\uC81C\uB098\uCC98\uB7FC, \uD3C9\uD654\uB85C\uC6B4 \uD558\uB8E8\uC5EC\uC57C
      \uD588\uC744\uAC81\uB2C8\uB2E4"
    - "\uC774\uACF3\uC5D0\uB294 \uC720\uB09C\uD788 \uAD81\uAE08\uD55C \uAC83\uC774
      \uB9CE\uC740 \uCE5C\uAD6C\uAC00 \uD558\uB098 \uC0B4\uACE0 \uC788\uC5C8\uB2F5\uB2C8\uB2E4.\r\n\r\n\uADF8
      \uCE5C\uAD6C\uB294 \uC624\uB298\uB3C4 \uC0C8\uB85C\uC6B4 \uACF3\uC744 \uCC3E\uC544\r\n\uC774\uACF3\uC800\uACF3\uC744
      \uD0D0\uD5D8\uD558\uACE0 \uC788\uC5C8\uC8E0."
  - id: 1
    lines:
    - "\uADF8\uB7EC\uB358 \uC911,\r\n\r\n'\uCE5C\uAD6C\uB294 \uC9C0\uAE08\uAE4C\uC9C0
      \uD55C \uBC88\uB3C4 \uBCF8 \uC801 \uC5C6\uB294 \uB3D9\uAD74\uC744 \uBC1C\uACAC\uD588\uC5B4\uC694.'"
    - "\uD638\uAE30\uC2EC\uC744 \uCC38\uC9C0 \uBABB\uD55C \uCE5C\uAD6C\uB294 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uB3D9\uAD74 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC14\uC8E0.\r\n\r\n\uADF8\uB9AC\uACE0
      \uADF8\uACF3\uC5D0\uC11C \uC544\uC8FC \uB180\uB77C\uC6B4 \uAC83\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
  - id: 2
    lines:
    - "\uB3D9\uAD74\uC758 \uBCBD\uC5D0\uB294 \uC624\uB798\uB41C \uADF8\uB9BC\uB4E4\uC774
      \uC0C8\uACA8\uC838 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uADF8\uB9BC \uC18D\uC5D0\uB294
      \uC790\uC2E0\uB4E4\uACFC \uB2EE\uC558\uC9C0\uB9CC \uC5B4\uB518\uAC00 \uB2E4\uB978
      \uC874\uC7AC\uB4E4\uC774 \uADF8\uB824\uC838 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uADF8\uB4E4\uC740 \uAC70\uB300\uD55C \uAC74\uBB3C\uC744 \uB9CC\uB4E4\uACE0,\r\n\uC2E0\uAE30\uD55C
      \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD558\uBA70,\r\n\uCE5C\uAD6C\uAC00 \uD55C \uBC88\uB3C4
      \uBCF8 \uC801 \uC5C6\uB294 \uC218\uB9CE\uC740 \uAC83\uB4E4\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uACE0
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uD558\uC9C0\uB9CC \uCE5C\uAD6C\uB294 \uAE00\uC744 \uC77D\uC744 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uADF8\uB9BC\uC744
      \uB530\uB77C \uAC78\uC73C\uBA70,\r\n\uADF8\uB4E4\uC774 \uC5BC\uB9C8\uB098 \uB300\uB2E8\uD55C
      \uC874\uC7AC\uC600\uB294\uC9C0\uB97C \uC0C1\uC0C1\uD588\uC2B5\uB2C8\uB2E4."
    - "\uADF8\uB4E4\uC740 \uAC70\uB300\uD55C \uAC74\uBB3C\uC744 \uB9CC\uB4E4\uACE0,\r\n\uC2E0\uAE30\uD55C
      \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD558\uBA70,\r\n\uCE5C\uAD6C\uAC00 \uD55C \uBC88\uB3C4
      \uBCF8 \uC801 \uC5C6\uB294 \uC218\uB9CE\uC740 \uAC83\uB4E4\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uACE0
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uD558\uC9C0\uB9CC \uCE5C\uAD6C\uB294 \uAE00\uC744 \uC77D\uC744 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uADF8\uB9BC\uC744
      \uB530\uB77C \uAC78\uC73C\uBA70,\r\n\uADF8\uB4E4\uC774 \uC5BC\uB9C8\uB098 \uB300\uB2E8\uD55C
      \uC874\uC7AC\uC600\uB294\uC9C0\uB97C \uC0C1\uC0C1\uD588\uC2B5\uB2C8\uB2E4."
    - "\uADF8\uB9AC\uACE0 \uBCBD\uD654\uC758 \uB9C8\uC9C0\uB9C9.\r\n\r\n\uADF8 \uC874\uC7AC\uB4E4\uC740\r\n\uD558\uB098\uC758
      \uAC70\uB300\uD55C \uB098\uBB34\uB85C \uD5A5\uD588\uC2B5\uB2C8\uB2E4."
    - "\uB098\uBB34 \uC704\uC5D0\uB294 \uB208\uBD80\uC2E0 \uBE5B\uC774 \uB0B4\uB9AC\uACE0
      \uC788\uC5C8\uC9C0\uB9CC,\r\n\uC548\uD0C0\uAE5D\uAC8C\uB3C4 \uADF8 \uB108\uBA38\uC758
      \uBCBD\uD654\uB294 \uBD80\uC11C\uC838 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uCE5C\uAD6C\uB294
      \uD55C\uB3D9\uC548 \uBCBD\uD654\uB97C \uBC14\uB77C\uBCF4\uC558\uC2B5\uB2C8\uB2E4."
  - id: 3
    lines:
    - "\uCE5C\uAD6C\uB294 \uACE7\uC7A5 \uB3D9\uC0B0\uC73C\uB85C \uB3CC\uC544\uAC00\r\n\uCE5C\uD55C
      \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uC790\uC2E0\uC774 \uBCF8 \uAC83\uC744 \uC774\uC57C\uAE30\uD588\uB2F5\uB2C8\uB2E4."
    - "\u201C\uADF8\uB4E4\uC740 \uC6B0\uB9AC\uBCF4\uB2E4 \uD6E8\uC52C \uD798\uC774
      \uC140 \uAC70\uC57C!\u201D"
    - "\u201C\uBD84\uBA85 \uC6B0\uB9AC\uBCF4\uB2E4 \uD6E8\uC52C \uB9CE\uC740 \uAC78
      \uC54C\uACE0 \uC788\uC744 \uAC70\uC57C!\u201D"
    - "\u201C\uC5C4\uCCAD \uC544\uB984\uB2F5\uACE0 \uBA4B\uC9C4 \uBAA8\uC2B5\uC77C
      \uAC83 \uAC19\uC544!\u201D"
    - "\u201C\uD55C \uBC88\uB3C4 \uBA39\uC5B4\uBCF4\uC9C0 \uBABB\uD55C \uB9DB\uC788\uB294
      \uAC83\uB3C4 \uC794\uB729 \uC54C\uACE0 \uC788\uACA0\uC9C0?\u201D"
    - "\uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uBCBD\uD654 \uC18D \uC874\uC7AC\uB4E4\uC740\r\n\uC790\uC2E0\uB4E4\uC774
      \uC6D0\uD558\uB294 \uBAA8\uB4E0 \uAC83\uC744 \uAC00\uC9C4 \uC644\uBCBD\uD55C
      \uC874\uC7AC\uCC98\uB7FC \uBCF4\uC600\uC2B5\uB2C8\uB2E4."
    - "\uB354 \uAC15\uD558\uACE0, \uB354 \uB9CE\uC740 \uAC83\uC744 \uC54C\uACE0,
      \uB354 \uC544\uB984\uB2F5\uACE0,\r\uC9C0\uAE08\uAECF \uB9DB\uBCF4\uC9C0 \uBABB\uD55C
      \uAC83\uB4E4\uAE4C\uC9C0 \uC54C\uACE0 \uC788\uB294 \uC874\uC7AC."
    - "\uC800\uB807\uAC8C \uB300\uB2E8\uD55C \uC874\uC7AC\uB4E4\uC774\uB77C\uBA74\r\n\uC5B4\uCA4C\uBA74
      \uADF8\uB4E4\uC5D0\uAC8C \uB3C4\uB2EC\uD560 \uC218\uB9CC \uC788\uB2E4\uBA74\u2014\r\n\r\n\uC790\uC2E0\uB4E4\uB3C4
      \uADF8\uB4E4\uACFC \uAC19\uC740 \uC874\uC7AC, \uC778\uAC04\uC774 \uB420 \uC218
      \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
  - id: 4
    lines:
    - "\uB2E4\uC74C \uB0A0.\r\n\r\n\uB124 \uCE5C\uAD6C\uB294 \uB3D9\uAD74 \uC55E\uC5D0
      \uBAA8\uC5EC \uC624\uB798\uB41C \uD1B5\uB85C\uB85C \uD5A5\uD588\uC5B4\uC694."
    - "\uADF8\uB7EC\uB098 \uCE5C\uAD6C\uB4E4\uC740 \uC544\uC9C1 \uC54C\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n\uADF8
      \uAE38 \uB05D\uC5D0\uC11C \uBB34\uC5C7\uC744 \uB9CC\uB098\uAC8C \uB420\uC9C0."
    - "\uC790\uC2E0\uB4E4\uC774 \uADF8\uD1A0\uB85D \uB300\uB2E8\uD558\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uB358 \uC778\uAC04\uB4E4\uC774\r\n\uACFC\uC5F0 \uC815\uB9D0
      \uC644\uBCBD\uD55C \uC874\uC7AC\uB4E4\uC774\uC5C8\uB294\uC9C0.\r\n\r\n\uC778\uAC04\uC774
      \uB41C\uB2E4\uB294 \uAC83\uC774 \uACFC\uC5F0 \uBB34\uC5C7\uC744 \uC758\uBBF8\uD558\uB294\uC9C0\uB97C
      \uB9D0\uC774\uC8E0."
    - "\uD558\uC9C0\uB9CC \uADF8\uAC74 \uC870\uAE08 \uB098\uC911\uC758 \uC774\uC57C\uAE30.\r\n\r\n\uC9C0\uAE08\uC740
      \uADF8\uC800\u2014\r\n\uD589\uC6B4\uC744 \uBE4C\uC5B4\uB4DC\uB9B4\uAC8C\uC694.
      \uCE5C\uAD6C\uB4E4."
